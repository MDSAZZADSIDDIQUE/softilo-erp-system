# Copy to .env. The API and the seed read it when they start.

# Leave DATABASE_URL empty to use the embedded PGlite database in .data/ (evaluation and development only).
DATABASE_URL=
# Postgres role the API runs queries as. Must NOT be a superuser or table owner, so RLS applies.
DATABASE_APP_ROLE=softilo_app
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info

# 1 shows the demo sign-in on the login page in production. Only for a server holding nothing but demo data.
DEMO_MODE=

# Read by the web app when it is built: where /api is proxied to. Must be set for `pnpm build`, not only at start.
API_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------- outside services
# Every service runs on a built-in demo provider unless switched to live. INTEGRATIONS=live switches them all;
# each can be set on its own (e.g. HMRC_MODE=live). A live service missing its credentials is logged at start-up.
INTEGRATIONS=demo
# Encrypts stored HMRC and bank tokens. Required in production: openssl rand -base64 32
SECRETS_KEY=
# Public address of the web app, used for HMRC and bank sign-in redirects (defaults to the request's host).
PUBLIC_URL=

# AI (Google Gemini). Reading documents and the assistant go live as soon as a key is set; AI_MODE=demo turns it off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# HMRC Making Tax Digital (VAT) and Check a UK VAT number. Developer Hub application credentials.
HMRC_MODE=
HMRC_ENV=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
VAT_CHECK_MODE=
VENDOR_PUBLIC_IP=

# Open Banking bank feeds through TrueLayer (an FCA-authorised account information provider).
BANK_FEED_MODE=
TRUELAYER_ENV=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

# Companies House public data API.
COMPANIES_HOUSE_MODE=
COMPANIES_HOUSE_API_KEY=

# Email (Postmark). In demo mode messages stay in the outbox and nothing is sent.
EMAIL_MODE=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=

# Exchange rates: demo reference rates, or live ECB rates (no key needed).
FX_MODE=

# Automations run inside the API every few minutes. AUTOMATIONS=off on all but one process if you run several.
AUTOMATIONS=
AUTOMATION_TICK_MINUTES=5
