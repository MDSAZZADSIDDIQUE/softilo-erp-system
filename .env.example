# Leave DATABASE_URL empty to use the embedded PGlite database in .data/ (development only).
DATABASE_URL=
# Postgres role the API runs queries as. Must NOT be a superuser or table owner, so RLS applies.
DATABASE_APP_ROLE=softilo_app
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
